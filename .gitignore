# Ignore everything in root except web/ folder
# The web/ folder has its own git repository

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/

# Database
*.db
data/*.db
!data/.gitkeep

# Debug files
debug/
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.backup
*_old.*

# Generated files (keep local)
mountain_huts_map.html

# Security & Secrets
*.key
*.pem
*.p12
*.pfx
*.jks
.env
.env.local
.env.*.local
secrets/
*.secret
*_secret.*
config/secrets.*
**/secrets.yaml
**/secrets.yml

# API Keys and tokens (if accidentally committed)
*api_key*
*token*
*password*
*credential*
*.credentials

